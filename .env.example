# Public site URL used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.asiantopwellness.com

# Server-only enquiry delivery settings. Never expose the API key with NEXT_PUBLIC_.
RESEND_API_KEY=re_replace_me
ENQUIRY_FROM_EMAIL=ATW Website <website@asiantopwellness.com>
ENQUIRY_TO_EMAIL=info@asiantopwellness.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable GA entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Google Search Console "HTML tag" verification token (the content value only).
# Leave empty if the domain is verified through a DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=
